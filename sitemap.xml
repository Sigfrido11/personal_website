---
layout: null
permalink: /sitemap.xml
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% assign all_docs = site.pages | concat: site.posts | concat: site.portfolio %}
  {% for doc in all_docs %}
    {% if doc.url and doc.sitemap != false and doc.url != '/sitemap.xml' and doc.url != '/en/sitemap.xml' %}
  <url>
    <loc>{{ doc.url | absolute_url }}</loc>
      {% if doc.lang_ref %}
        {% assign translation_it = all_docs | where: "lang_ref", doc.lang_ref | where: "lang", "it" | first %}
        {% assign translation_en = all_docs | where: "lang_ref", doc.lang_ref | where: "lang", "en" | first %}
        {% if translation_it %}
    <xhtml:link rel="alternate" hreflang="it" href="{{ translation_it.url | absolute_url }}" />
        {% endif %}
        {% if translation_en %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ translation_en.url | absolute_url }}" />
        {% endif %}
      {% endif %}
  </url>
    {% endif %}
  {% endfor %}
</urlset>
