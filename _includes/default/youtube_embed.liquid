{% assign youtube_url = include.youtube_url | default: page.youtube_url %}
{% assign youtube_title = include.title | default: page.title %}

{% if youtube_url != nil and youtube_url != "" %}
  <div class="yt-embed">
    <iframe
      class="yt-embed__iframe"
      src="{{ youtube_url | replace: 'watch?v=', 'embed/' }}"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen>
    </iframe>
  </div>
{% endif %}